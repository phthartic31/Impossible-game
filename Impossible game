def approach(value, target, amount):
    """Move value towards target by at most amount (never overshoots)."""
    if value < target:
        return min(value + amount, target)
    return max(value - amount, target)


def lerp_color(a, b, t):
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


class SoundBank:
    """Generates all sound effects in code (square waves and noise)."""

    def __init__(self):
        self.enabled = SOUND_ENABLED
        self.sounds = {}
        if not self.enabled:
            return
        info = pygame.mixer.get_init()
        if not info or info[1] != -16:
            self.enabled = False       # no audio device / odd format
            return
        self.rate, _, self.channels = info
        try:
            self.sounds = {
                "jump": self.tone(300, 620, 0.13, 0.22),
                "coin": self.tone(900, 1350, 0.10, 0.22),
                "stomp": self.tone(260, 90, 0.12, 0.30, noise=0.3),
                "death": self.tone(420, 50, 0.55, 0.30, noise=0.45),
                "pop": self.tone(140, 700, 0.07, 0.25),
                "check": self.tone(520, 1040, 0.25, 0.22),
                "win": self.tone(520, 1560, 0.55, 0.22),
                "boss": self.tone(120, 40, 0.35, 0.35, noise=0.4),
                "thud": self.tone(90, 40, 0.15, 0.35, noise=0.5),
                "oneup": self.tone(700, 1400, 0.30, 0.22),
            }
        except Exception:                 # sound must never crash the game
            self.enabled = False

    def tone(self, f0, f1, dur, vol, noise=0.0):
        n = int(self.rate * dur)
        buf = array.array("h")
        phase = 0.0
        for i in range(n):
            t = i / n
            phase += (f0 + (f1 - f0) * t) / self.rate
            wave = 1.0 if (phase % 1.0) < 0.5 else -1.0
            if noise:
                wave = wave * (1 - noise) + random.uniform(-1, 1) * noise
            value = int(wave * (1 - t) * vol * 32767)
            for _ in range(self.channels):
                buf.append(value)
        return pygame.mixer.Sound(buffer=buf.tobytes())

    def play(self, name):
        if self.enabled and name in self.sounds:
            self.sounds[name].play()

    def toggle(self):
        self.enabled = not self.enabled
        if not self.enabled:
            pygame.mixer.stop()


class Particle:
    """A tiny coloured square that flies, falls and fades."""

    def __init__(self, x, y, vx, vy, life, color, size, gravity=700.0):
        self.x, self.y, self.vx, self.vy = x, y, vx, vy
        self.life = self.max_life = life
        self.color, self.size, self.gravity = color, size, gravity

    def update(self, dt):
        self.life -= dt
        self.vy += self.gravity * dt
        self.x += self.vx * dt
        self.y += self.vy * dt

    def draw(self, surf, ox, oy):
        s = max(1, int(self.size * self.life / self.max_life))
        pygame.draw.rect(surf, self.color, (int(self.x + ox), int(self.y + oy), s, s))


