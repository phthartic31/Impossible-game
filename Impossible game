        pygame.draw.line(surf, (90, 90, 100), (r.centerx, -5), (r.centerx, r.centery), 3)
        pygame.draw.circle(surf, (110, 110, 125), r.center, 15)
        for a in range(0, 360, 45):        # spikes
            ang = math.radians(a)
            tip = (r.centerx + math.cos(ang) * 21, r.centery + math.sin(ang) * 21)
            b1 = (r.centerx + math.cos(ang + 0.3) * 13, r.centery + math.sin(ang + 0.3) * 13)
            b2 = (r.centerx + math.cos(ang - 0.3) * 13, r.centery + math.sin(ang - 0.3) * 13)
            pygame.draw.polygon(surf, (190, 190, 205), [tip, b1, b2])
        pygame.draw.circle(surf, (60, 60, 70), r.center, 9)
        pygame.draw.circle(surf, RED, (r.centerx - 3, r.centery - 2), 3)
        pygame.draw.circle(surf, RED, (r.centerx + 3, r.centery - 2), 3)


class Boss(Enemy):
    """Big angry blob.  Stomp its head three times.  It jumps at you."""

    kill_cause = "boss"

    def __init__(self, x, y, left_bound, right_bound):
        super().__init__(x, y, 80, 80)
        self.hp = self.max_hp = 3
        self.left_bound, self.right_bound = left_bound, right_bound
        self.invuln = 0.0
        self.jump_timer = 2.0
        self.was_air = False

    def update(self, game, dt):
        super().update(game, dt)
        if not self.alive:
            return
        self.invuln = max(0.0, self.invuln - dt)
        speed = 70 + (self.max_hp - self.hp) * 35     # gets faster when hurt
        px = game.player.rect.centerx
        if self.on_ground:
            self.vx = self.dir * speed
            if self.rect.left < self.left_bound:
                self.dir = 1
            elif self.rect.right > self.right_bound:
                self.dir = -1
            self.jump_timer -= dt
            if self.jump_timer <= 0:                  # big leaping attack
                self.vy = -760
                self.dir = 1 if px > self.rect.centerx else -1
                self.vx = self.dir * speed * 2.2
                self.jump_timer = max(1.2, 2.6 - (self.max_hp - self.hp) * 0.5)
        else:
            # keep leaps inside the arena
            if (self.rect.left < self.left_bound and self.vx < 0) or \
                    (self.rect.right > self.right_bound and self.vx > 0):
                self.vx = 0
        self.move_body(game, dt)
        if self.on_ground and self.was_air:           # landing shockwave
            game.shake = max(game.shake, 9)
            game.sfx("thud")
            game.spawn_burst(self.rect.centerx, self.rect.bottom, (220, 200, 160), 14)
        self.was_air = not self.on_ground

    def on_stomp(self, game):
        if self.invuln > 0:
            return
        self.hp -= 1
        self.invuln = 1.3
        game.shake = max(game.shake, 10)
        game.sfx("boss")
        game.spawn_burst(self.rect.centerx, self.rect.top, (255, 120, 80), 24)
        if self.hp <= 0:
            self.alive = False
            self.squish = 0.6
            game.boss_defeated()

    def draw(self, surf, ox, oy):
        r = self.rect.move(ox, oy)
        if not self.alive:
            pygame.draw.ellipse(surf, (120, 30, 40), (r.x - 6, r.bottom - 14, r.w + 12, 14))
            return
        if self.invuln > 0 and int(self.invuln * 14) % 2 == 0:
            return                                     # blink when hurt
        pygame.draw.ellipse(surf, (60, 15, 30), r.inflate(6, 6))
        pygame.draw.ellipse(surf, (170, 35, 55), r)
        for side in (-1, 1):                           # horns
            x = r.centerx + side * 26
            pygame.draw.polygon(surf, (240, 230, 200),
                                [(x - 8, r.y + 12), (x + side * 8, r.y - 16), (x + 8, r.y + 12)])
        for dx in (-17, 17):
            pygame.draw.circle(surf, WHITE, (r.centerx + dx, r.y + 32), 11)
            pygame.draw.circle(surf, BLACK, (r.centerx + dx + self.dir * 3, r.y + 34), 5)
        pygame.draw.line(surf, BLACK, (r.centerx - 30, r.y + 18), (r.centerx - 6, r.y + 27), 4)
        pygame.draw.line(surf, BLACK, (r.centerx + 30, r.y + 18), (r.centerx + 6, r.y + 27), 4)
        pygame.draw.arc(surf, BLACK, (r.centerx - 20, r.y + 48, 40, 24), 0.4, 2.7, 4)


class Trap:
    """Spikes.  kind 'spike' is always visible; kind 'hidden' pops up out
    of the floor when the player gets close."""

    def __init__(self, col, row, kind):
        self.kind = kind
        self.base = pygame.Rect(col * TILE, row * TILE, TILE, TILE)
        self.state = "up" if kind == "spike" else "hidden"
        self.rise = 1.0 if kind == "spike" else 0.0

    def update(self, game, dt):
        if self.kind != "hidden":
            return
        p = game.player
        if self.state == "hidden":
            if p.alive and abs(p.rect.centerx - self.base.centerx) < HIDDEN_SPIKE_TRIGGER \
                    and abs(p.rect.bottom - self.base.bottom) < 90:
                self.state = "rising"
                game.sfx("pop")
        elif self.state == "rising":
            self.rise = min(1.0, self.rise + dt / 0.07)    # shoots out fast
            if self.rise >= 1.0:
                self.state = "up"

    def hurt_rect(self):
        h = int(TILE * 0.8 * self.rise)
        return pygame.Rect(self.base.x + 6, self.base.bottom - h, TILE - 12, h)

    @property
    def dangerous(self):
        return self.rise > 0.15

    def draw(self, surf, ox, oy):
        if self.rise <= 0:
            return
        h = int(TILE * 0.8 * self.rise)
        x, bottom = self.base.x + ox, self.base.bottom + oy
        for i in range(3):                 # three triangles
            left = x + 2 + i * 11
            pygame.draw.polygon(surf, (225, 225, 235),
                                [(left, bottom), (left + 5, bottom - h), (left + 10, bottom)])
            pygame.draw.polygon(surf, (150, 150, 165),
                                [(left + 5, bottom - h), (left + 10, bottom), (left + 5, bottom)])


