class Game:
    def __init__(self):
        pygame.mixer.pre_init(22050, -16, 1, 512)
        pygame.init()
        pygame.display.set_caption("Blobby Is Doomed")
        self.screen = pygame.display.set_mode((SCREEN_W, SCREEN_H))
        self.clock = pygame.time.Clock()
        self.font_s = pygame.font.Font(None, 24)
        self.font_m = pygame.font.Font(None, 36)
        self.font_l = pygame.font.Font(None, 72)
        self.font_xl = pygame.font.Font(None, 104)
        self.sound = SoundBank()
        self.tiles = self.build_tiles()
        self.dim = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
        self.dim.fill((0, 0, 0, 120))
        self.hills = self.build_hills()
        self.backgrounds = {}
        self.clouds = [(random.randint(0, 2400), random.randint(30, 200), random.uniform(0.7, 1.4))
                       for _ in range(14)]
        self.state = "title"
        self.running = True
        self.time = 0.0
        self.shake = 0.0
        self.particles = []
        self.level_index = 0
        self.lives = START_LIVES
        self.coins = 0
        self.deaths = 0
        self.lives_awarded = 0
        self.cp = None
        self.level_start_coins = 0
        self.collected = set()
        self.taunt = ""
        self.state_timer = 0.0
        self.level_time = 0.0
        self.cam_x = 0.0
        self.jump_held = False
        self.boss_dead = False
        self.toast = ("", 0.0)
        self.empty_level()

    # ------------------------------------------------------------ setup
    def build_tiles(self):
        def base(color):
            s = pygame.Surface((TILE, TILE)).convert()
            s.fill(color)
            return s
        dirt = base(DIRT)
        random.seed(7)
        for _ in range(10):
            pygame.draw.rect(dirt, DIRT_DARK, (random.randint(2, TILE - 6), random.randint(2, TILE - 6), 4, 3))
        random.seed()
        grass = dirt.copy()
        pygame.draw.rect(grass, GRASS, (0, 0, TILE, 10))
        pygame.draw.rect(grass, GRASS_LIGHT, (0, 0, TILE, 4))
        for x in range(2, TILE, 7):
            pygame.draw.polygon(grass, GRASS, [(x, 9), (x + 3, 14), (x + 6, 9)])
        brick = base(BRICK)
        pygame.draw.rect(brick, BRICK_DARK, (0, 0, TILE, TILE), 2)
        for y in (TILE // 3, 2 * TILE // 3):
            pygame.draw.line(brick, BRICK_DARK, (0, y), (TILE, y), 2)
        pygame.draw.line(brick, BRICK_DARK, (TILE // 2, 0), (TILE // 2, TILE // 3), 2)
        pygame.draw.line(brick, BRICK_DARK, (TILE // 4, TILE // 3), (TILE // 4, 2 * TILE // 3), 2)
        pygame.draw.line(brick, BRICK_DARK, (3 * TILE // 4, TILE // 3), (3 * TILE // 4, 2 * TILE // 3), 2)
        pygame.draw.line(brick, BRICK_DARK, (TILE // 2, 2 * TILE // 3), (TILE // 2, TILE), 2)
        plank = base(PLANK)
        pygame.draw.rect(plank, PLANK_DARK, (0, 0, TILE, TILE), 2)
        for y in (12, 24):
            pygame.draw.line(plank, PLANK_DARK, (2, y), (TILE - 2, y), 1)
        pygame.draw.circle(plank, PLANK_DARK, (6, 6), 2)
        pygame.draw.circle(plank, PLANK_DARK, (TILE - 6, 6), 2)
        used = base(USED)
        pygame.draw.rect(used, (70, 50, 40), (0, 0, TILE, TILE), 3)
        pygame.draw.rect(used, (90, 68, 54), (8, 8, TILE - 16, TILE - 16), 2)
        return {"dirt": dirt, "grass": grass, "brick": brick, "plank": plank, "used": used}

    def build_hills(self):
        w = 1280
        s = pygame.Surface((w, 260), pygame.SRCALPHA)
        random.seed(3)
        for i in range(9):
            cx = i * 160 + random.randint(-30, 30)
            rad = random.randint(90, 170)
            pygame.draw.circle(s, (60, 110, 90, 150), (cx, 260 + 20), rad)
        random.seed()
        return s

    def background_for(self, index):
        if index not in self.backgrounds:
            top, bottom = LEVELS[index]["sky"]
            bg = pygame.Surface((SCREEN_W, SCREEN_H)).convert()
            for y in range(SCREEN_H):
                pygame.draw.line(bg, lerp_color(top, bottom, y / SCREEN_H), (0, y), (SCREEN_W, y))
            self.backgrounds[index] = bg
        return self.backgrounds[index]

    def empty_level(self):
        self.platforms, self.solid_platforms, self.solid_rects = [], [], []
        self.enemies, self.traps, self.coins_list = [], [], []
        self.goals, self.checkpoints = [], []
        self.level_w, self.level_h = SCREEN_W, SCREEN_H
        self.player = Player(0, 0)
        self.player.alive = False

    # ------------------------------------------------------------ levels
    def load_level(self, index, use_checkpoint):
        """Build every object from the ASCII map.  Called at level start
        and again after each death (so all traps reset)."""
        rows = list(LEVELS[index]["map"])
        while len(rows) < ROWS:
            rows.insert(0, "")                 # pad the sky on top
        width = max(len(r) for r in rows)
        grid = [r.ljust(width, ".") for r in rows]
        self.level_w, self.level_h = width * TILE, len(grid) * TILE
        self.platforms, self.enemies, self.traps = [], [], []
        self.coins_list, self.goals, self.checkpoints = [], [], []
        self.boss_dead = False
        has_boss = any("B" in r for r in grid)
        solid_chars = "#=?CWP"
        tilemap = {}
        start = (TILE, TILE)

        if use_checkpoint and self.cp:
            self.collected = set(self.cp["collected"])
            self.coins = self.cp["coins"]
        else:
            self.collected = set()
            self.coins = self.level_start_coins

        for r, row in enumerate(grid):
            for c, ch in enumerate(row):
                x, y = c * TILE, r * TILE
                above = grid[r - 1][c] if r > 0 else "."
                exposed = above not in solid_chars
                kinds = {"#": "ground", "=": "brick", "F": "fake", "?": "invisible",
                         "C": "collapse", "W": "slide", "P": "pit"}
                if ch in kinds:
                    plat = Platform(c, r, kinds[ch], exposed)
                    self.platforms.append(plat)
                    tilemap[(c, r)] = plat
                elif ch == "@":
                    start = (x + (TILE - Player.W) // 2, y + TILE - Player.H)
                elif ch == "o":
                    if (c, r) not in self.collected:
                        self.coins_list.append(Coin(c, r))
                elif ch == "e":
                    self.enemies.append(Walker(x + 4, y + TILE - 26))
                elif ch == "w":
                    self.enemies.append(Walker(x + 4, y + TILE - 26, spiky=True))
                elif ch == "b":
                    self.enemies.append(Bat(x + 4, y + 8))
                elif ch == "d":
                    self.enemies.append(Dropper(x + 3, y + 3))
                elif ch == "B":
                    cx = x + TILE // 2
                    self.enemies.append(Boss(cx - 40, y + TILE - 80,
                                             cx - 7 * TILE, cx + 7 * TILE))
                elif ch == "^":
                    self.traps.append(Trap(c, r, "hidden"))
                elif ch == "S":
                    self.traps.append(Trap(c, r, "spike"))
                elif ch == "K":
                    cp = Checkpoint(c, r)
                    self.checkpoints.append(cp)
                elif ch == "G":
                    self.goals.append(Goal(c, r, fake=False, hidden=has_boss))
                elif ch == "X":
                    self.goals.append(Goal(c, r, fake=True))

        # sliding planks that touch each other move as one piece
        for (c, r), plat in tilemap.items():
            if plat.kind == "slide":
                left = tilemap.get((c - 1, r))
                if left and left.kind == "slide":
                    plat.group = left.group
                    left.group.append(plat)

        if use_checkpoint and self.cp:
            start = self.cp["pos"]
            for cp in self.checkpoints:
                if cp.rect.x <= self.cp["x"]:
                    cp.active = True
        self.player = Player(*start)
        self.refresh_solids()
        self.cam_x = clamp(self.player.rect.centerx - SCREEN_W * 0.4, 0, self.level_w - SCREEN_W)
        self.level_time = 0.0
        self.particles = []

    def refresh_solids(self):
        self.platforms = [p for p in self.platforms if not p.dead]
        self.solid_platforms = [p for p in self.platforms if p.solid]
        self.solid_rects = [p.rect for p in self.solid_platforms]

    def start_game(self):
        self.lives, self.coins, self.deaths = START_LIVES, 0, 0
        self.lives_awarded = 0
        self.level_index = 0
        self.begin_level()

    def begin_level(self):
        self.cp = None
        self.level_start_coins = self.coins
        self.load_level(self.level_index, use_checkpoint=False)
        self.state = "playing"

    def restart_level(self):
        self.cp = None
        self.load_level(self.level_index, use_checkpoint=False)
        self.state = "playing"

    # ------------------------------------------------------------ events
    def sfx(self, name):
        self.sound.play(name)

    def spawn_burst(self, x, y, color, count, spread=220, up=True):
        for _ in range(count):
            if len(self.particles) > 400:
                return
            ang = random.uniform(0, math.tau)
            sp = random.uniform(0.3, 1.0) * spread
            self.particles.append(Particle(
                x, y, math.cos(ang) * sp, math.sin(ang) * sp - (80 if up else 0),
                random.uniform(0.35, 0.8), color, random.randint(3, 6)))

    def kill_player(self, cause):
        if self.state != "playing" or not self.player.alive:
            return
        self.player.alive = False
        self.deaths += 1
        self.lives -= 1
        self.taunt = random.choice(TAUNTS.get(cause, TAUNTS["generic"]))
        self.state, self.state_timer = "dying", DEATH_TIME
        self.shake = 14
        r = self.player.rect
        self.spawn_burst(r.centerx, r.centery, BLOB, 26, spread=320)
        self.spawn_burst(r.centerx, r.centery, WHITE, 10, spread=260)
        self.sfx("death")

    def boss_defeated(self):
        self.boss_dead = True
        for g in self.goals:
            g.hidden = False
            self.spawn_burst(g.rect.centerx, g.rect.centery, GOLD, 30, spread=300)
        self.toast = ("The boss is down... the goal appeared!", 3.0)

    def level_clear(self):
        self.state, self.state_timer = "levelclear", LEVEL_CLEAR_TIME
        self.sfx("win")
        r = self.player.rect
        for color in (GOLD, (255, 120, 120), (120, 255, 150), (120, 180, 255)):
            self.spawn_burst(r.centerx, r.centery, color, 25, spread=380)

    def handle_events(self):
        for ev in pygame.event.get():
            if ev.type == pygame.QUIT:
                self.running = False
            elif ev.type == pygame.KEYDOWN:
                if ev.key == pygame.K_ESCAPE:
                    self.running = False
                elif ev.key == pygame.K_m:
                    self.sound.toggle()
                elif ev.key in (pygame.K_SPACE, pygame.K_UP, pygame.K_w):
                    if self.state == "playing":
                        self.player.press_jump()
                    elif self.state == "title":
                        self.start_game()
                elif ev.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                    if self.state == "title":
                        self.start_game()
                    elif self.state in ("gameover", "win"):
                        self.state = "title"
                elif ev.key == pygame.K_r:
                    if self.state in ("playing", "dying") and self.lives > 0:
                        self.restart_level()
                    elif self.state in ("gameover", "win"):
                        self.state = "title"

    # ------------------------------------------------------------ update
    def update(self, dt):
        self.time += dt
        self.shake = max(0.0, self.shake - 30 * dt)
        if self.toast[1] > 0:
            self.toast = (self.toast[0], self.toast[1] - dt)
        for p in self.particles:
            p.update(dt)
        self.particles = [p for p in self.particles if p.life > 0]

        if self.state == "playing":
            self.update_playing(dt)
        elif self.state == "dying":
            self.state_timer -= dt
            if self.state_timer <= 0:
                if self.lives <= 0:
                    self.state = "gameover"
                else:
                    self.load_level(self.level_index, use_checkpoint=True)
                    self.state, self.state_timer = "respawn", RESPAWN_TIME
        elif self.state == "respawn":
            self.state_timer -= dt
            if self.state_timer <= 0:
                self.state = "playing"
        elif self.state == "levelclear":
            self.state_timer -= dt
            if self.state_timer <= 0:
                self.level_index += 1
                if self.level_index >= len(LEVELS):
                    self.state = "win"
                    self.sfx("win")
                else:
                    self.begin_level()

    def update_playing(self, dt):
        keys = pygame.key.get_pressed()
        left = keys[pygame.K_LEFT] or keys[pygame.K_a]
        right = keys[pygame.K_RIGHT] or keys[pygame.K_d]
        self.jump_held = keys[pygame.K_SPACE] or keys[pygame.K_UP] or keys[pygame.K_w]
        self.level_time += dt
        p = self.player
        view_l, view_r = self.cam_x - 400, self.cam_x + SCREEN_W + 400

        for plat in self.platforms:
            if view_l < plat.rect.x < view_r or plat.falling or plat.triggered:
                plat.update(self, dt)
        if any(pl.dead for pl in self.platforms):
            self.refresh_solids()
        else:
            self.solid_platforms = [pl for pl in self.platforms if pl.solid]
            self.solid_rects = [pl.rect for pl in self.solid_platforms]

        p.update(self, dt, left, right, self.jump_held)
        if self.state != "playing":
            return

        for t in self.traps:
            if view_l < t.base.x < view_r:
                t.update(self, dt)
                if t.dangerous and t.hurt_rect().colliderect(p.rect):
                    self.kill_player("hidden" if t.kind == "hidden" else "spike")
                    return

        for e in self.enemies:
            if e.alive and view_l < e.rect.x < view_r:
                e.update(self, dt)
            elif not e.alive and e.squish > 0:
                e.update(self, dt)
        for e in self.enemies:
            if not e.alive or not e.rect.colliderect(p.rect):
                continue
            from_above = p.vy > 0 and (p.rect.bottom - e.rect.top) < max(14, p.vy * STEP * 1.6 + 8)
            if e.stompable and from_above:
                e.on_stomp(self)
                p.vy = -(STOMP_BOUNCE_HELD if self.jump_held else STOMP_BOUNCE)
                p.fy = float(p.rect.y)
                self.sfx("stomp")
                self.spawn_burst(e.rect.centerx, e.rect.top, (255, 220, 150), 8)
            else:
                self.kill_player(e.kill_cause)
                return
        self.enemies = [e for e in self.enemies if e.alive or e.squish > 0]

        for c in self.coins_list[:]:
            if c.rect.colliderect(p.rect):
                self.coins_list.remove(c)
                self.collected.add(c.key)
                self.coins += 1
                self.sfx("coin")
                self.spawn_burst(c.rect.centerx, c.rect.centery, GOLD, 8, spread=140)
                if self.coins // COIN_LIFE > self.lives_awarded:
                    self.lives_awarded += 1
                    self.lives += 1
                    self.sfx("oneup")
                    self.toast = ("1UP!  Extra life!", 2.0)

        for cp in self.checkpoints:
            if not cp.active and cp.rect.colliderect(p.rect):
                cp.active = True
                self.cp = {"pos": (cp.rect.x + 2, cp.rect.bottom - Player.H - 1),
                           "x": cp.rect.x, "coins": self.coins,
                           "collected": set(self.collected)}
                self.toast = ("Checkpoint!", 1.6)
                self.sfx("check")
                self.spawn_burst(cp.rect.centerx, cp.rect.top, GOLD, 12)

        for g in self.goals:
            if not g.hidden and g.rect.colliderect(p.rect):
                if g.fake:
                    g.triggered = True
                    self.kill_player("fakegoal")
                else:
                    self.level_clear()
                return

        target = clamp(p.rect.centerx - SCREEN_W * 0.4, 0, self.level_w - SCREEN_W)
        self.cam_x += (target - self.cam_x) * min(1.0, 6 * dt)

    # ------------------------------------------------------------ drawing
    def draw_text(self, text, font, color, x, y, center=True, shadow=True):
        if shadow:
            img = font.render(text, True, (0, 0, 0))
            rect = img.get_rect(center=(x + 2, y + 2)) if center else img.get_rect(topleft=(x + 2, y + 2))
            self.screen.blit(img, rect)
        img = font.render(text, True, color)
        rect = img.get_rect(center=(x, y)) if center else img.get_rect(topleft=(x, y))
        self.screen.blit(img, rect)

    def draw_world(self):
        scr = self.screen
        scr.blit(self.background_for(self.level_index), (0, 0))
        cam = self.cam_x
        # parallax hills and clouds
        hx = -int(cam * 0.25) % 1280
        scr.blit(self.hills, (hx - 1280, SCREEN_H - 270))
        scr.blit(self.hills, (hx, SCREEN_H - 270))
        if self.level_index != 2:                        # no clouds at night
            for cx, cy, sc in self.clouds:
                x = (cx - cam * 0.5) % (SCREEN_W + 300) - 150
                pygame.draw.ellipse(scr, (255, 255, 255), (x, cy, 90 * sc, 30 * sc))
                pygame.draw.ellipse(scr, (255, 255, 255), (x + 20 * sc, cy - 14 * sc, 50 * sc, 30 * sc))
        else:
            random.seed(11)
            for _ in range(50):
                sx, sy = random.randint(0, SCREEN_W), random.randint(0, 300)
                pygame.draw.circle(scr, (255, 255, 230), (int((sx - cam * 0.1) % SCREEN_W), sy), 1)
            random.seed()

        sx = sy = 0
        if self.shake > 0:
            sx = random.randint(-int(self.shake), int(self.shake))
            sy = random.randint(-int(self.shake), int(self.shake))
        ox, oy = -int(cam) + sx, sy
        vis = pygame.Rect(int(cam) - 80, -80, SCREEN_W + 160, SCREEN_H + 160)

        for plat in self.platforms:
            if plat.rect.colliderect(vis):
                plat.draw(scr, ox, oy, self.tiles)
        for t in self.traps:
            if t.base.colliderect(vis):
                t.draw(scr, ox, oy)
        for cp in self.checkpoints:
            cp.draw(scr, ox, oy, self.time)
        for g in self.goals:
            g.draw(scr, ox, oy, self.time)
        for c in self.coins_list:
            if c.rect.colliderect(vis):
                c.draw(scr, ox, oy, self.time)
        for e in self.enemies:
            if e.rect.colliderect(vis):
                e.draw(scr, ox, oy)
        if self.state in ("playing", "levelclear"):
            self.player.draw(scr, ox, oy)
        elif self.state == "respawn":
            self.draw_respawn(ox, oy)
        for p in self.particles:
            p.draw(scr, ox, oy)

    def draw_respawn(self, ox, oy):
        """Blob materialises inside a shrinking ring."""
        t = 1.0 - clamp(self.state_timer / RESPAWN_TIME, 0, 1)
        r = self.player.rect
        cx, cy = r.centerx + ox, r.centery + oy
        ring = int((1 - t) * 70) + 8
        pygame.draw.circle(self.screen, WHITE, (cx, cy), ring, 2)
        pygame.draw.circle(self.screen, BLOB, (cx, cy), ring // 2, 1)
        k = t * t * (3 - 2 * t)                          # smoothstep
        w, h = max(2, int(r.w * 1.2 * k)), max(2, int(r.h * k))
        body = pygame.Rect(0, 0, w, h)
        body.midbottom = (cx, r.bottom + oy)
        pygame.draw.ellipse(self.screen, BLOB, body)
        if random.random() < 0.5:
            a = random.uniform(0, math.tau)
            self.particles.append(Particle(cx + math.cos(a) * ring, cy + math.sin(a) * ring,
                                           -math.cos(a) * 60, -math.sin(a) * 60, 0.3, BLOB, 3, 0))

    def draw_hud(self):
        scr = self.screen
        pygame.draw.ellipse(scr, BLOB, (14, 12, 22, 22))
        pygame.draw.circle(scr, WHITE, (21, 21), 3)
        pygame.draw.circle(scr, WHITE, (29, 21), 3)
        self.draw_text(f"x {max(0, self.lives)}", self.font_m, HUD_TEXT, 44, 14, center=False)
        pygame.draw.circle(scr, GOLD, (130, 24), 10)
        pygame.draw.circle(scr, (200, 140, 20), (130, 24), 10, 2)
        self.draw_text(f"x {self.coins}", self.font_m, HUD_TEXT, 146, 14, center=False)
        self.draw_text(f"Deaths: {self.deaths}", self.font_m, (255, 150, 150), 236, 14, center=False)
        title = f"World {self.level_index + 1}: {LEVELS[self.level_index]['name']}"
        self.draw_text(title, self.font_s, HUD_TEXT, SCREEN_W - 14 - self.font_s.size(title)[0], 16, center=False)
        if not self.sound.enabled:
            self.draw_text("muted (M)", self.font_s, (200, 200, 200), SCREEN_W - 100, 40, center=False)
        for e in self.enemies:                            # boss health bar
            if isinstance(e, Boss) and e.alive and abs(e.rect.centerx - self.player.rect.centerx) < 700:
                x = SCREEN_W // 2 - 120
                pygame.draw.rect(scr, (40, 10, 10), (x - 3, 57, 246, 22))
                pygame.draw.rect(scr, RED, (x, 60, int(240 * e.hp / e.max_hp), 16))
                self.draw_text("BOSS", self.font_s, WHITE, SCREEN_W // 2, 68)
        if self.state == "playing" and self.level_time < 3.0:
            alpha_t = clamp(3.0 - self.level_time, 0, 1)
            col = lerp_color((0, 0, 0), WHITE, alpha_t) if alpha_t < 1 else WHITE
            self.draw_text(f"World {self.level_index + 1}: {LEVELS[self.level_index]['name']}",
                           self.font_l, col, SCREEN_W // 2, 150)
            self.draw_text(LEVELS[self.level_index]["hint"], self.font_m, col, SCREEN_W // 2, 200)
        if self.toast[1] > 0:
            self.draw_text(self.toast[0], self.font_m, GOLD, SCREEN_W // 2, 110)

    def draw_title(self):
        scr = self.screen
        scr.blit(self.background_for(0), (0, 0))
        scr.blit(self.hills, (0, SCREEN_H - 270))
        pygame.draw.rect(scr, DIRT, (0, SCREEN_H - 90, SCREEN_W, 90))
        pygame.draw.rect(scr, GRASS, (0, SCREEN_H - 90, SCREEN_W, 14))
        bob = math.sin(self.time * 3) * 10
        for i, ch in enumerate("BLOBBY IS DOOMED"):       # wobbling title letters
            img = self.font_xl.render(ch, True, WHITE)
            x = SCREEN_W // 2 - 380 + i * 47
            y = 110 + math.sin(self.time * 3 + i * 0.5) * 8
            shadow = self.font_xl.render(ch, True, (30, 60, 90))
            scr.blit(shadow, (x + 4, y + 4))
            scr.blit(img, (x, y))
        # bouncing blob mascot
        cx, cy = SCREEN_W // 2, SCREEN_H - 95 - abs(math.sin(self.time * 3)) * 70
        pygame.draw.ellipse(scr, BLOB_DARK, (cx - 30, cy - 52, 60, 56))
        pygame.draw.ellipse(scr, BLOB, (cx - 28, cy - 50, 56, 52))
        for dx in (-10, 10):
            pygame.draw.circle(scr, WHITE, (cx + dx, cy - 30), 8)
            pygame.draw.circle(scr, BLACK, (cx + dx + 2, cy - 29), 3)
        self.draw_text("An impossible platformer. Trust nothing.", self.font_m, WHITE, SCREEN_W // 2, 235)
        if int(self.time * 2) % 2 == 0:
            self.draw_text("Press ENTER or SPACE to start", self.font_m, GOLD, SCREEN_W // 2, 300)
        lines = ["Arrows / A D: move     Space / Up / W: jump (hold = higher)",
                 "R: restart level       M: mute       Esc: quit"]
        for i, line in enumerate(lines):
            self.draw_text(line, self.font_s, WHITE, SCREEN_W // 2, 350 + i * 26)

    def draw_end_screen(self, title, color, lines):
        scr = self.screen
        scr.fill((18, 14, 30))
        self.draw_text(title, self.font_xl, color, SCREEN_W // 2, 130)
        for i, line in enumerate(lines):
            self.draw_text(line, self.font_m, WHITE, SCREEN_W // 2, 230 + i * 44)
        if int(self.time * 2) % 2 == 0:
            self.draw_text("Press ENTER for the title screen", self.font_m, GOLD, SCREEN_W // 2, 460)

    def draw(self):
        if self.state == "title":
            self.draw_title()
        elif self.state == "gameover":
            self.draw_end_screen("GAME OVER", RED, [
                f"You died {self.deaths} times.",
                f"Coins collected: {self.coins}",
                "Honestly? Pretty impressive.",
                "The game was impossible. We warned you."])
        elif self.state == "win":
            self.draw_end_screen("YOU WON?!", GOLD, [
                "You beat the impossible game!",
                f"Deaths: {self.deaths}      Coins: {self.coins}",
                "Nobody believed it could be done.",
                "(Neither did we.)"])
        else:
            self.draw_world()
            self.draw_hud()
            if self.state == "dying":
                self.screen.blit(self.dim, (0, 0))
                self.draw_text(self.taunt, self.font_l, WHITE, SCREEN_W // 2, SCREEN_H // 2 - 30)
                self.draw_text(f"Deaths: {self.deaths}    Lives left: {max(0, self.lives)}",
                               self.font_m, (255, 190, 190), SCREEN_W // 2, SCREEN_H // 2 + 30)
            elif self.state == "levelclear":
                self.draw_text("LEVEL CLEAR!", self.font_xl, GOLD, SCREEN_W // 2, SCREEN_H // 2 - 20)
                self.draw_text(f"Deaths so far: {self.deaths}", self.font_m, WHITE,
                               SCREEN_W // 2, SCREEN_H // 2 + 40)
        pygame.display.flip()

    # ------------------------------------------------------------ main loop
    def run(self):
        accumulator = 0.0
        while self.running:
            frame = self.clock.tick(FPS) / 1000.0
            accumulator += min(frame, 0.25)       # cap so lag can't spiral
            self.handle_events()
            while accumulator >= STEP:            # fixed-step physics
                self.update(STEP)
                accumulator -= STEP
            self.draw()
        pygame.quit()


def main():
    Game().run()


if __name__ == "__main__":
    main()
    sys.exit(0)