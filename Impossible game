class Platform:
    """One tile of terrain.  `kind` decides how it behaves:

    ground / brick .. plain solid tiles
    fake ............ looks like a brick but is NOT solid
    invisible ....... solid but invisible until bumped
    collapse ........ crumbles shortly after you stand on it
    slide ........... slides sideways after you stand on it
    pit ............. ground that drops away when you get close
    """

    SOLID_KINDS = ("ground", "brick", "invisible", "collapse", "slide", "pit")

    def __init__(self, col, row, kind, exposed=True):
        self.kind = kind
        self.rect = pygame.Rect(col * TILE, row * TILE, TILE, TILE)
        self.fx, self.fy = float(self.rect.x), float(self.rect.y)
        self.solid = kind in self.SOLID_KINDS
        self.exposed = exposed        # nothing solid above (grass on top)
        self.triggered = False
        self.falling = False
        self.timer = 0.0
        self.vy = 0.0
        self.dir = 1
        self.alpha = 255
        self.revealed = False
        self.dead = False
        self.group = [self]           # tiles that slide together

    # ----- reactions to the player -----
    def on_stand(self, game, player):
        """Called every frame the player stands on this tile."""
        if self.triggered or player.rect.bottom != self.rect.top:
            return
        if self.kind == "collapse":
            self.triggered = True
        elif self.kind == "slide":
            direction = 1 if player.vx >= 0 else -1
            for tile in self.group:
                tile.triggered = True
                tile.dir = direction

    def on_bump(self, game):
        """Called when the player bumps into this tile."""
        if self.kind == "invisible" and not self.revealed:
            self.revealed = True
            game.sfx("thud")
            game.spawn_burst(self.rect.centerx, self.rect.centery, USED, 8)

    # ----- per-frame update -----
    def update(self, game, dt):
        player = game.player
        if self.kind == "collapse" and self.triggered:
            self.timer += dt
            if self.timer >= COLLAPSE_DELAY and not self.falling:
                self.solid, self.falling = False, True
        elif self.kind == "slide" and self.triggered:
            self.timer += dt
            if self.timer >= SLIDE_DELAY:
                self.fx += self.dir * SLIDE_SPEED * dt
                self.rect.x = int(self.fx)
                if self.timer > 2.2:
                    self.dead = True
        elif self.kind == "pit" and not self.triggered:
            if (player.alive and
                    abs(player.rect.centerx - self.rect.centerx) < PIT_TRIGGER):
                self.triggered = True
                self.solid, self.falling = False, True
                game.sfx("pop")
        elif self.kind == "fake" and not self.triggered:
            if player.alive and self.rect.colliderect(player.rect):
                self.triggered = True
        if self.kind == "fake" and self.triggered:
            self.alpha -= int(900 * dt)
            if self.alpha <= 0:
                self.dead = True
        if self.falling:
            self.vy += GRAVITY * dt
            self.fy += self.vy * dt
            self.rect.y = int(self.fy)
            if self.rect.y > game.level_h + 100:
                self.dead = True

    def draw(self, surf, ox, oy, tiles):
        pos = (self.rect.x + ox, self.rect.y + oy)
        if self.kind in ("ground", "pit"):
            surf.blit(tiles["grass" if self.exposed else "dirt"], pos)
        elif self.kind in ("brick", "fake"):
            img = tiles["brick"]
            if self.kind == "fake" and self.triggered:
                img = img.copy()
                img.set_alpha(max(0, self.alpha))
            surf.blit(img, pos)
        elif self.kind in ("collapse", "slide"):
            shake = (random.randint(-1, 1), 0) if (
                self.kind == "collapse" and self.triggered and not self.falling) else (0, 0)
            surf.blit(tiles["plank"], (pos[0] + shake[0], pos[1]))
        elif self.kind == "invisible" and self.revealed:
            surf.blit(tiles["used"], pos)


class Enemy:
    """Base class for everything that hurts you.  Handles gravity and
    tile collisions so subclasses only describe behaviour."""

    stompable = True
    kill_cause = "enemy"

    def __init__(self, x, y, w, h):
        self.rect = pygame.Rect(int(x), int(y), w, h)
        self.fx, self.fy = float(x), float(y)
        self.vx = self.vy = 0.0
        self.alive = True
        self.squish = 0.0             # >0 while the flattened body is visible
        self.dir = -1
        self.on_ground = False
        self.hit_wall = False
        self.t = random.random() * 10

    def move_body(self, game, dt):
        """Gravity + collision against solid tiles."""
        rects = game.solid_rects
        self.vy = min(self.vy + GRAVITY * dt, MAX_FALL)
        self.fx += self.vx * dt
        self.rect.x = int(round(self.fx))
        self.hit_wall = False
        for i in self.rect.collidelistall(rects):
            r = rects[i]
            if not self.rect.colliderect(r):
                continue
            if self.vx > 0:
                self.rect.right = r.left
            elif self.vx < 0:
                self.rect.left = r.right
            else:
                continue
            self.fx = float(self.rect.x)
            self.hit_wall = True
        self.fy += self.vy * dt
        self.rect.y = int(round(self.fy))
        for i in self.rect.collidelistall(rects):
            r = rects[i]
            if not self.rect.colliderect(r):
                continue
            if self.vy > 0:
                self.rect.bottom = r.top
            elif self.vy < 0:
                self.rect.top = r.bottom
            else:
                continue
            self.fy = float(self.rect.y)
            self.vy = 0.0
        self.on_ground = self.rect.move(0, 1).collidelist(rects) != -1
        if self.rect.top > game.level_h + 200:
            self.alive = False

    def update(self, game, dt):
        self.t += dt
        if self.squish > 0:
            self.squish -= dt

    def on_stomp(self, game):
        self.alive = False
        self.squish = 0.35

    def draw(self, surf, ox, oy):
        pass


class Walker(Enemy):
    """Patrols back and forth.  The spiky version cannot be stomped."""

    def __init__(self, x, y, spiky=False):
        super().__init__(x, y, 28, 26)
        self.spiky = spiky
        self.stompable = not spiky
        self.kill_cause = "spike" if spiky else "enemy"

    def update(self, game, dt):
        super().update(game, dt)
        if not self.alive:
            return
        ahead = pygame.Rect(self.rect.centerx + self.dir * (self.rect.w // 2 + 3),
                            self.rect.bottom + 3, 2, 2)
        if self.on_ground and ahead.collidelist(game.solid_rects) == -1:
            self.dir *= -1                 # turn around at ledges
        if self.hit_wall:
            self.dir *= -1
        self.vx = self.dir * WALKER_SPEED
        self.move_body(game, dt)

    def draw(self, surf, ox, oy):
        r = self.rect.move(ox, oy)
        if not self.alive:                 # flattened
            flat = pygame.Rect(r.x - 2, r.bottom - 8, r.w + 4, 8)
            pygame.draw.ellipse(surf, (150, 70, 40), flat)
            return
        body_col = (110, 60, 130) if self.spiky else (190, 80, 50)
        pygame.draw.ellipse(surf, body_col, r)
        if self.spiky:                     # spikes on the head
            for i in range(4):
                x = r.x + 3 + i * 7
                pygame.draw.polygon(surf, (230, 230, 240),
                                    [(x, r.y + 6), (x + 3, r.y - 6), (x + 6, r.y + 6)])
        for dx in (-5, 5):                 # angry eyes
            pygame.draw.circle(surf, WHITE, (r.centerx + dx, r.y + 11), 4)
            pygame.draw.circle(surf, BLACK, (r.centerx + dx + self.dir, r.y + 12), 2)
        pygame.draw.line(surf, BLACK, (r.centerx - 10, r.y + 5), (r.centerx - 2, r.y + 8), 2)
        pygame.draw.line(surf, BLACK, (r.centerx + 10, r.y + 5), (r.centerx + 2, r.y + 8), 2)
        step = int(self.t * 8) % 2         # little feet
        pygame.draw.ellipse(surf, (60, 30, 20), (r.x + 1 + step * 3, r.bottom - 5, 10, 6))
        pygame.draw.ellipse(surf, (60, 30, 20), (r.right - 11 - step * 3, r.bottom - 5, 10, 6))


class Bat(Enemy):
    """Sleeps until you come close, then flies straight at you."""

    def __init__(self, x, y):
        super().__init__(x, y, 28, 22)
        self.awake = False

    def update(self, game, dt):
        super().update(game, dt)
        if not self.alive:
            return
        p = game.player
        dx = p.rect.centerx - self.rect.centerx
        dy = p.rect.centery - self.rect.centery
        dist = math.hypot(dx, dy)
        if not self.awake and p.alive and dist < BAT_WAKE_DISTANCE:
            self.awake = True
        if self.awake and p.alive and dist > 1:
            self.fx += dx / dist * BAT_SPEED * dt
            self.fy += dy / dist * BAT_SPEED * dt + math.sin(self.t * 6) * 0.8
            self.dir = 1 if dx > 0 else -1
        elif not self.awake:
            self.fy += math.sin(self.t * 3) * 0.3
        self.rect.topleft = (int(self.fx), int(self.fy))

    def draw(self, surf, ox, oy):
        r = self.rect.move(ox, oy)
        if not self.alive:
            pygame.draw.ellipse(surf, (90, 40, 120), (r.x, r.bottom - 7, r.w, 7))
            return
        flap = math.sin(self.t * (18 if self.awake else 4)) * 8
        for side in (-1, 1):               # wings
            cx = r.centerx + side * 6
            pygame.draw.polygon(surf, (70, 30, 100), [
                (cx, r.centery), (cx + side * 16, r.centery - 8 - flap),
                (cx + side * 14, r.centery + 5)])
        pygame.draw.ellipse(surf, (110, 50, 150), r)
        for dx in (-5, 5):
            pygame.draw.circle(surf, (255, 240, 120) if self.awake else WHITE,
                               (r.centerx + dx, r.centery - 2), 3)
            pygame.draw.circle(surf, BLACK, (r.centerx + dx, r.centery - 2), 1)


class Dropper(Enemy):
    """A spiked ball that waits on the ceiling, drops when you walk
    under it, then slowly rises back up."""

    stompable = False
    kill_cause = "dropper"

    def __init__(self, x, y):
        super().__init__(x, y, 30, 30)
        self.home_y = float(y)
        self.state = "wait"
        self.timer = 0.0

    def update(self, game, dt):
        super().update(game, dt)
        p = game.player
        if self.state == "wait":
            if (p.alive and abs(p.rect.centerx - self.rect.centerx) < DROPPER_TRIGGER
                    and p.rect.centery > self.rect.centery):
                self.state, self.vy = "fall", 0.0
        elif self.state == "fall":
            self.vy = min(self.vy + DROPPER_GRAVITY * dt, 1400)
            self.fy += self.vy * dt
            self.rect.y = int(self.fy)
            hit = self.rect.collidelist(game.solid_rects)
            if hit != -1:
                self.rect.bottom = game.solid_rects[hit].top
                self.fy = float(self.rect.y)
                self.state, self.timer = "rest", 0.9
                game.sfx("thud")
                game.shake = max(game.shake, 5)
                game.spawn_burst(self.rect.centerx, self.rect.bottom, (200, 200, 210), 8)
        elif self.state == "rest":
            self.timer -= dt
            if self.timer <= 0:
                self.state = "rise"
        elif self.state == "rise":
            self.fy -= 140 * dt
            self.rect.y = int(self.fy)
            if self.fy <= self.home_y:
                self.fy = self.home_y
                self.rect.y = int(self.fy)
                self.state = "wait"

    def draw(self, surf, ox, oy):
