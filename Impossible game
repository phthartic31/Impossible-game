class Player:
    W, H = 24, 30

    def __init__(self, x, y):
        self.rect = pygame.Rect(int(x), int(y), self.W, self.H)
        self.fx, self.fy = float(x), float(y)
        self.vx = self.vy = 0.0
        self.on_ground = False
        self.coyote = 0.0
        self.jump_buf = 0.0
        self.facing = 1
        self.alive = True
        self.squash = 1.0
        self.run_t = 0.0

    def press_jump(self):
        self.jump_buf = JUMP_BUFFER

    def update(self, game, dt, left, right, jump_held):
        axis = (1 if right else 0) - (1 if left else 0)
        if axis:
            self.facing = axis
        # --- horizontal acceleration / friction ---
        accel = GROUND_ACCEL if self.on_ground else AIR_ACCEL
        fric = GROUND_FRICTION if self.on_ground else AIR_FRICTION
        if axis:
            if self.vx * axis < 0:
                accel *= 1.6                 # snappy turn-around
            self.vx = approach(self.vx, axis * MOVE_SPEED, accel * dt)
        else:
            self.vx = approach(self.vx, 0.0, fric * dt)
        # --- coyote time + jump buffer ---
        self.coyote = COYOTE_TIME if self.on_ground else max(0.0, self.coyote - dt)
        self.jump_buf = max(0.0, self.jump_buf - dt)
        if self.jump_buf > 0 and self.coyote > 0:
            self.vy = -JUMP_SPEED
            self.jump_buf = self.coyote = 0.0
            self.squash = 1.25
            game.sfx("jump")
            game.spawn_burst(self.rect.centerx, self.rect.bottom, (220, 220, 220), 4, spread=60)
        # --- gravity (stronger when jump released = variable height) ---
        g = GRAVITY * (JUMP_CUT if (self.vy < 0 and not jump_held) else 1.0)
        impact = self.vy
        self.vy = min(self.vy + g * dt, MAX_FALL)

        rects, plats = game.solid_rects, game.solid_platforms
        # --- move X ---
        self.fx += self.vx * dt
        self.rect.x = int(round(self.fx))
        for i in self.rect.collidelistall(rects):
            r = rects[i]
            if not self.rect.colliderect(r):
                continue
            if self.vx > 0:
                self.rect.right = r.left
            elif self.vx < 0:
                self.rect.left = r.right
            else:
                continue
            self.fx = float(self.rect.x)
            self.vx = 0.0
            plats[i].on_bump(game)
        if self.rect.left < 0:
            self.rect.left, self.fx, self.vx = 0, 0.0, 0.0
        if self.rect.right > game.level_w:
            self.rect.right = game.level_w
            self.fx, self.vx = float(self.rect.x), 0.0
        # --- move Y ---
        self.fy += self.vy * dt
        self.rect.y = int(round(self.fy))
        for i in self.rect.collidelistall(rects):
            r = rects[i]
            if not self.rect.colliderect(r):
                continue
            if self.vy > 0:
                self.rect.bottom = r.top
            elif self.vy < 0:
                self.rect.top = r.bottom
                plats[i].on_bump(game)
            else:
                continue
            self.fy = float(self.rect.y)
            self.vy = 0.0
        # --- ground probe (1 pixel below our feet) ---
        was_ground = self.on_ground
        probe = self.rect.move(0, 1)
        hits = probe.collidelistall(rects)
        self.on_ground = bool(hits) and self.vy >= 0
        for i in hits:
            plats[i].on_stand(game, self)
        if self.on_ground and not was_ground and impact > 350:
            self.squash = 0.7
            game.spawn_burst(self.rect.centerx, self.rect.bottom, (220, 220, 220), 5, spread=80)
        self.squash += (1.0 - self.squash) * min(1.0, 12 * dt)
        self.run_t += abs(self.vx) * dt * 0.06
        if self.rect.top > game.level_h + 40:
            game.kill_player("fall")

    def draw(self, surf, ox, oy):
        r = self.rect
        sx = sy = 1.0
        if not self.on_ground:
            stretch = clamp(abs(self.vy) / 2500.0, 0, 0.25)
            sx, sy = 1 - stretch * 0.6, 1 + stretch
        sy *= self.squash
        sx *= 2.0 - self.squash
        w, h = int(r.w * 1.2 * sx), int(r.h * sy)
        body = pygame.Rect(0, 0, w, h)
        body.midbottom = (r.centerx + ox, r.bottom + oy)
        pygame.draw.ellipse(surf, BLOB_DARK, body.inflate(4, 4))
        pygame.draw.ellipse(surf, BLOB, body)
        pygame.draw.ellipse(surf, (150, 235, 225), (body.x + w // 5, body.y + h // 8, w // 4, h // 5))
        ey = body.y + int(h * 0.38)
        for dx in (-5, 5):
            ex = body.centerx + dx + self.facing * 3
            pygame.draw.circle(surf, WHITE, (ex, ey), 5)
            pygame.draw.circle(surf, BLACK, (ex + self.facing * 2, ey + 1), 2)
        if self.on_ground and abs(self.vx) > 20:          # tiny running feet
            s = math.sin(self.run_t) * 4
        else:
            s = 0
        pygame.draw.ellipse(surf, BLOB_DARK, (body.centerx - 10 + s, body.bottom - 4, 9, 6))
        pygame.draw.ellipse(surf, BLOB_DARK, (body.centerx + 1 - s, body.bottom - 4, 9, 6))


